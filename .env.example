# Copy this file to .env before running: docker compose up --build
# Never commit the copied .env file.

# Your existing server-side AI provider key. Do not use a VITE_ variable.
AI_MODE=openrouter
AI_MODEL=openai/gpt-4.1-mini
AI_API_KEY=replace-with-your-ai-provider-key

# Generate two different long random values. Example PowerShell command:
# [Convert]::ToBase64String([byte[]](1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

MONGO_DB_NAME=cloudmentor
FRONTEND_PORT=8080
